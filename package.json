{
  "name": "grandplex-movie-booking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GrandPlex \u2014 a local, frontend-only movie discovery and ticket-booking demonstration with Max, an on-device booking concierge.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:assets": "node scripts/check-assets.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:brand && npm run validate:content && npm run check:assets && npm run check:i18n && npm run check:untranslated && npm run test && npm run build && npm run check:classes",
    "check:classes": "node scripts/check-classes.mjs",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.mjs",
    "check:untranslated": "node scripts/check-untranslated.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "verify:trailers": "node scripts/verify-trailers.mjs"
  },
